  "query": "SELECT p.id, p.public_key, p.sign_count, u.id AS user_id, u.email, u.created_at, u.is_admin, u.avatar_key\n           FROM passkeys p JOIN users u ON u.id = p.user_id\n           WHERE p.credential_id = $1 FOR UPDATE OF p",
