  "db_name": "PostgreSQL",
  "query": "UPDATE jobs SET state = 'running', locked_by = $1, locked_until = now() + make_interval(secs => $2),\n               attempts = attempts + 1\n           WHERE id = (\n               SELECT id FROM jobs\n               WHERE state = 'queued' AND run_at <= now() AND kind = ANY($3)\n               ORDER BY run_at\n               LIMIT 1\n               FOR UPDATE SKIP LOCKED\n           )\n           RETURNING id, kind, payload::text AS \"payload!\", attempts, max_attempts",
