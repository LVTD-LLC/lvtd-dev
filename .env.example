# Copy to .env for local development. Every variable the app reads is here.

# --- Server ---
BIND_ADDR=0.0.0.0:3000
# Public origin, no trailing slash. https:// turns on Secure cookies.
SITE_URL=http://localhost:3000
RUST_LOG=lvtd_dev=info,core=info,auth=info,tower_http=info

# --- Database (required). `docker compose up -d` provides this one. ---
DATABASE_URL=postgres://postgres:lvtd-dev@localhost:5433/lvtd-dev

# --- Sessions ---
SESSION_TTL_DAYS=30

# --- File storage (storage Cargo feature; profile pictures are the example) ---
# Leave every STORAGE_S3_* value blank to keep uploads on this machine under STORAGE_LOCAL_DIR.
# Set all four (region optional) to use any S3-compatible bucket: Cloudflare R2, AWS S3, MinIO, Backblaze B2...
STORAGE_LOCAL_DIR=./storage
STORAGE_S3_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com   AWS: https://s3.<region>.amazonaws.com   MinIO: http://localhost:9000
STORAGE_S3_ENDPOINT=
# R2 accepts "auto" (the default); AWS needs the bucket's region.
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Optional: where the bucket is public (an R2 custom domain, a CDN). Uploads are then linked
# there directly; otherwise the app serves them itself at /avatars/...
STORAGE_S3_PUBLIC_URL=

# --- Background jobs (durable, stored in Postgres; see app/content/docs/background-jobs.md) ---
# true  = this process serves HTTP and runs the job worker (default; one container does everything)
# false = serve HTTP only; a separate container with JOBS_WORKER=only (or `lvtd-dev worker`) runs jobs
# only  = run jobs only and answer /healthz
JOBS_WORKER=true
# Jobs running at once in this process. Each may use one database connection while it runs SQL.
JOBS_CONCURRENCY=2
# Wait between polls when nothing in this process enqueued a job.
JOBS_POLL_SECONDS=5
# Time given to running jobs at shutdown; keep below the container stop grace period (Docker: 10s).
JOBS_SHUTDOWN_SECONDS=8

# --- Optional PostHog (enable the desired posthog-* Cargo features first) ---
# Use your own project's public ingestion token. Blank disables every export.
POSTHOG_PROJECT_TOKEN=
# EU projects: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
# Fraction of new request traces to export; logs/errors are independent.
POSTHOG_TRACE_SAMPLE_RATIO=0.1

# --- Sentry (selected Cargo capabilities only; blank DSN disables all) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Sample rates apply only when their capability is selected.
SENTRY_TRACES_SAMPLE_RATE=1.0
# Replay masks text/inputs/media. Error-session replay also requires sentry-errors.
SENTRY_REPLAY_SAMPLE_RATE=0.25
# Chromium browser profiling only; Sentry does not support Rust profiling.
SENTRY_PROFILE_SAMPLE_RATE=0.25

# Optional stripe Cargo feature: hosted Checkout and customer portal.
# Leave all four blank to run without configured billing. No publishable key needed.
# Prefer a restricted key with the permissions listed in README.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure either or both prices from your own Stripe account (same test/live mode).
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_PAYMENT_PRICE_ID=

# Optional qdrant Cargo feature: vector search, scoped per user. Bring your own embeddings.
# Blank URL disables it; the collection is created at startup if missing.
# Local: `docker compose --profile qdrant up -d`; Cloud: https://xyz.cloud.qdrant.io:6333 plus an API key.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
# Dimension of your embedding model's vectors (e.g. 1536). Required when QDRANT_URL is set.
QDRANT_VECTOR_SIZE=
# Cosine (default), Euclid, Dot or Manhattan.
QDRANT_DISTANCE=Cosine

# Signup requires email verification. With the three Mailgun values blank, the
# app prints every email (verification codes included) to its log instead of
# sending it; that console mode only starts on a non-HTTPS SITE_URL, so a
# deployment that forgets these values fails to start.
# Use a domain-scoped Mailgun sending key, never the account admin key.
MAILGUN_SENDING_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=
# Generate independently with: openssl rand -hex 32 (a fixed development key
# is used in console mode when blank)
EMAIL_VERIFICATION_KEY=

# Optional google Cargo feature: sign up and sign in with Google. Set both or leave
# both blank to hide the button. Create a Web application OAuth client in Google
# Cloud and register SITE_URL + /auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional github Cargo feature: sign up and sign in with GitHub. Set both or leave
# both blank to hide the button. Create an OAuth App in GitHub's developer settings
# and set its authorization callback URL to SITE_URL + /auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- IndexNow (automatic for public HTTPS SITE_URL) ---
# Each origin gets a random ownership key persisted in Postgres. No external account needed.
# Disable on public staging/preview deployments. Local/HTTP/IP origins are skipped.
INDEXNOW_ENABLED=true
